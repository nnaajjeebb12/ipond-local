# ---------------------------------------------------------------------------
# Soletronix iPond — LOCAL APPLIANCE (Raspberry Pi)
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# ---------- Database ----------
# Must match the POSTGRES_* values below — docker-compose.yml creates the role.
DATABASE_URL=postgresql://soletronix:pass@localhost:5432/ipond

# Consumed by docker-compose.yml when the TimescaleDB container is created.
# The password is only read on the FIRST start; changing it later does not
# change the database's password.
POSTGRES_USER=soletronix
POSTGRES_PASSWORD=pass
POSTGRES_DB=ipond

# Where the database files live. Point this at an external SSD/USB drive on
# the Pi — SD cards wear out under database writes. Must exist before first
# start. Defaults to ./data/timescaledb if unset (fine for a dev machine).
DB_DATA_PATH=/mnt/ipond-data/timescaledb

# ---------- Ingestion (USB serial gateway) ----------
# The ESP32 gateway has no Wi-Fi. It prints readings over USB serial and
# scripts/serial-listener.js forwards them to POST /api/send-sensor-data using
# this token. Nothing outside the Pi needs it any more, but it still guards the
# endpoint on the LAN.
API_TOKEN=<any long random token — openssl rand -hex 32>

# The gateway's serial device. /dev/ttyUSB0 can change if other USB devices are
# present; the checklist shows how to pin a stable /dev/serial/by-id/... path.
SERIAL_PORT=/dev/ttyUSB0

# ---------- Timezone ----------
# APP_TIMEZONE drives server-side "Today" bucketing; the NEXT_PUBLIC_ copy is
# read in the browser. Keep all three in step.
TZ=Asia/Manila
APP_TIMEZONE=Asia/Manila
NEXT_PUBLIC_APP_TIMEZONE=Asia/Manila

# ---------- Cloud sync ----------
# Bearer token for POST /api/sync on the main server. Generate a fresh one and
# set the SAME value on the main server. MUST NOT equal API_TOKEN: a compromised
# ESP32 must not be able to bulk-write history, and a leaked sync token must not
# be able to pose as a sensor.
#   openssl rand -hex 32
SYNC_TOKEN=<new token for cloud sync — different from API_TOKEN>

# Where the sync worker ships readings.
MAIN_SERVER_URL=https://seeme-db.com

# This site's owner UUID on the MAIN SERVER. Every appliance codes its ponds
# PND-001..PND-010, so the cloud needs the owner to tell sites apart. Get it
# from Soletronix. The worker refuses to run without it — otherwise the server
# would accept the batch, skip every row, and the Pi would mark them all synced.
# This is the SEED value. It can be changed at runtime from Settings > Appliance
# (local admin login, verified with the main server) — that change is stored in
# the database and overrides this line from then on.
SYNC_OWNER_ID=<owner UUID on seeme-db.com, from Soletronix>

# Optional — sync worker log file. Defaults to ~/logs/sync-worker.log.
# SYNC_LOG_PATH=/home/pi/logs/sync-worker.log

# ---------- License ----------
# Signed license file for this appliance. Without a valid one the app shows the
# full-screen "License Expired" page and nothing else.
LICENSE_PATH=/home/pi/ipond-local/license.json
