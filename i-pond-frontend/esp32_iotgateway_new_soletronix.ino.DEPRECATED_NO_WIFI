const char *password = "12341234";
const char *serverName = "http://192.168.1.43/api/send-sensor-data";
const char *authToken = "d1a43d7e55abc5bb969de73dc40aa927e0725264730990bd72e21e088ddb5b1b";

const uint32_t WIFI_CONNECT_TIMEOUT_MS = 10000;
const uint32_t POST_DELAY_MS = 5000;

